{
  "name": "@guionai/volcengine-tts-provider",
  "version": "2026.8.1",
  "description": "Volcengine (豆包) provider plugin for OpenClaw — models + TTS. Maintained fork of upstream @openclaw/volcengine-provider for ClawHub distribution (upstream npm is a 0.0.0 placeholder).",
  "type": "module",
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:guionai/volcengine-tts-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true
    }
  }
}